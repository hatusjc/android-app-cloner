<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Minimal runtime surface for Clone Hub APK copy, install and progress. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Required to browse downloaded applications and reconcile hidden clone packages. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        tools:ignore="DataExtractionRules">

        <activity
            android:name="com.the412banner.bfe.MainActivity"
            android:theme="@style/AppTheme"
            android:screenOrientation="sensor"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pinned shortcuts are OWNED by the Clone Hub, not the clone package. -->
        <activity
            android:name="com.the412banner.bfe.clone.CloneShortcutActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- APK clone / edit / sign pipeline (ARSCLib rewrite + apksig), same lifecycle. -->
        <service
            android:name="com.the412banner.bfe.apk.ApkJobService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- FileProvider for "Open with" content:// hand-off of files inside the file manager. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
