/build
**/build/
.gradle/

# Local config
local.properties

# IDE
*.iml
.idea/
.kotlin/

# Keep signing keys out of the source tree. Original upstream key may remain in
# forked Git history, but cannot be used for our production/test-release APKs.
keystore/
*.keystore
*.jks
*.p12
*.pfx
*.pem
# Bundled native binaries under app/src/main/jniLibs/ are upstream runtime components.
